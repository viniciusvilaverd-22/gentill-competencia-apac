# Gentill Competência APAC
# Proteções de repositório público: build, arquivos locais, segredos e dados reais de APAC.

# =========================
# Build / binários
# =========================
build/
dist/
Debug/
Release/
Releases/
bin/
obj/
x64/
x86/
*.exe
*.dll
*.obj
*.pdb
*.ilk
*.msi
*.msix

# =========================
# IDEs / ambiente local
# =========================
.vs/
.vscode/
.idea/
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates

# =========================
# Temporários / sistema
# =========================
*.tmp
*.temp
*.bak
*.log
*.tlog
*.cache
Thumbs.db
Desktop.ini
.DS_Store
~$*

# =========================
# Configurações locais / segredos
# =========================
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*.snk
secrets/
private/

# =========================
# DADOS REAIS APAC — NÃO PUBLICAR
# Estes arquivos podem conter dados pessoais e dados pessoais sensíveis.
# =========================
APOCI.*
RCONSIST*
R0401*
R[0-9][0-9][0-9][0-9].*
dados-reais/
arquivos-reais/
test-data-private/
samples-private/
screenshots-private/

# =========================
# Auditorias e saídas geradas
# =========================
auditoria-*.txt
auditoria-*.json
AUDITORIA_*
relatorio-*.txt
output/
outputs/

# =========================
# Pacotes de distribuição
# Publique binários/ZIP preferencialmente via GitHub Releases.
# =========================
*.zip
*.7z
*.rar

# =========================
# Exemplos fictícios/anonimizados podem ser versionados
# =========================
!examples/
!examples/**
!samples/
!samples/**
