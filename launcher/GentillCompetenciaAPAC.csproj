<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Gentill_Competencia_APAC_v2.4.0</AssemblyName>
    <RootNamespace>GentillCompetenciaAPAC</RootNamespace>
    <Version>2.4.0</Version>
    <FileVersion>2.4.0.0</FileVersion>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <Company>Gentill Mob Ops</Company>
    <Product>Gentill Competência APAC</Product>
    <Description>Validador e conversor de competência APOCI/APAC com validação OCI/PMAE.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\src\index.html">
      <LogicalName>GentillCompetenciaAPAC.Embedded.index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\src\styles.css">
      <LogicalName>GentillCompetenciaAPAC.Embedded.styles.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\src\app.js">
      <LogicalName>GentillCompetenciaAPAC.Embedded.app.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
