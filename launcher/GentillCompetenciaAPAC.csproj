<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Gentill_Competencia_APAC_v2.4.2</AssemblyName>
    <RootNamespace>GentillCompetenciaAPAC</RootNamespace>
    <Version>2.4.2</Version>
    <FileVersion>2.4.2.0</FileVersion>
    <AssemblyVersion>2.4.2.0</AssemblyVersion>
    <Company>Gentill Mob Ops</Company>
    <Product>Gentill Competência APAC</Product>
    <Description>Conversor controlado de competência APOCI/APAC. Datas são somente diagnóstico e nunca bloqueiam a geração; somente campos estruturais de competência são alterados.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\src\index.html">
      <LogicalName>GentillCompetenciaAPAC.Embedded.index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\src\styles.css">
      <LogicalName>GentillCompetenciaAPAC.Embedded.styles.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\src\app.js">
      <LogicalName>GentillCompetenciaAPAC.Embedded.app.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>